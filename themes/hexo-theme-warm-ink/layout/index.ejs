<%
  /* 取配置 */
  const hero       = theme.hero        || {};
  const bento      = theme.bento_cards || [];
  const posts      = page.posts;

  /* 颜色 map — 4-color macaron */
  const colorMap = {
    orange: 'pastel-wash-orange',
    pink:   'pastel-wash-pink',
    mint:   'pastel-wash-mint',
    blue:   'pastel-wash-blue',
  };

  /* 最新一篇文章作为 Featured */
  const featured = posts && posts.length ? posts.data[0] : null;
%>

<main>

  <!-- ════ Hero ════ -->
  <div class="container">
    <section class="hero">

      <!-- Text -->
      <div class="hero-text">
        <span class="hero-badge"><%= hero.greeting || 'Hello!' %></span>
        <h1 class="hero-title">
          <%= hero.title_prefix || "Hello, I'm" %>
          <span class="scribble-underline"><%= hero.highlight_name || config.author %></span><span class="highlight"><%= hero.title_suffix || '. I craft stories with code.' %></span>
        </h1>
        <p class="hero-desc"><%= hero.description || config.description %></p>
        <a href="#content" class="hero-scroll-link">
          Scroll to explore my world
          <span class="material-symbols-outlined">arrow_downward</span>
        </a>
      </div>

      <!-- Portrait -->
      <div class="hero-image-wrap">
        <div class="hand-drawn-border sketch-shadow hero-image-frame">
          <% if (hero.image) { %>
            <img src="<%- url_for(hero.image) %>" alt="<%= hero.image_alt || config.author %>" />
          <% } else { %>
            <!-- Placeholder: replace with your own photo at themes/warm-ink/source/images/hero.jpg -->
            <div style="width:100%;aspect-ratio:1;background:var(--color-surface-container);display:flex;align-items:center;justify-content:center;">
              <span class="material-symbols-outlined" style="font-size:48px;color:var(--color-outline);">person</span>
            </div>
          <% } %>
        </div>
        <div class="hero-washi"></div>
      </div>

    </section>
  </div>

  <!-- ════ Bento Grid ════ -->
  <div class="container" id="content">
    <section class="bento-grid">
      <% bento.forEach(card => { %>
        <a href="<%- url_for(card.link) %>" class="bento-card hand-drawn-border active-press">
          <div class="bento-card-icon <%= colorMap[card.color] || 'pastel-wash-mint' %>">
            <span class="material-symbols-outlined text-primary"><%= card.icon %></span>
          </div>
          <h3 class="bento-card-title"><%= card.title %></h3>
          <p class="bento-card-desc"><%= card.desc %></p>
          <div class="bento-card-link">
            <span><%= card.link_text %></span>
            <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
          </div>
        </a>
      <% }) %>
    </section>
  </div>

  <!-- ════ Featured Post ════ -->
  <% if (featured) { %>
  <div class="container">
    <section class="featured-section">
      <div class="featured-header">
        <h2>Latest Scribble</h2>
        <span class="featured-date">
          Entry #<%= page.posts.length %> — <%= date(featured.date, 'MMMM D, YYYY') %>
        </span>
      </div>

      <a href="<%- url_for(featured.path) %>" class="featured-card hand-drawn-border">
        <% if (featured.cover) { %>
          <div class="featured-img">
            <img src="<%- url_for(featured.cover) %>" alt="<%= featured.title %>" />
          </div>
        <% } %>
        <div class="featured-content">
          <h3 class="featured-title"><%= featured.title %></h3>
          <p class="featured-excerpt">
            <%= featured.excerpt ? strip_html(featured.excerpt).substring(0, 180) + '...' : '' %>
          </p>
          <span class="featured-read-more">
            Continue reading
            <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
          </span>
        </div>
        <div class="featured-sticky-note">"Essential reading"</div>
      </a>
    </section>
  </div>
  <% } %>


</main>
