<%
  const author  = theme.author  || {};
  const social  = theme.social  || {};
  const donate  = theme.donate  || {};
%>

<main class="page-main">
  <div class="container">

    <!-- ════ Avatar + Title ════ -->
    <section style="display:flex;flex-direction:column;align-items:center;gap:28px;margin-bottom:56px;">
      <div style="position:relative;">
        <div class="hand-drawn-border sketch-shadow" style="padding:6px;display:inline-block;transform:rotate(1.5deg);transition:transform 0.5s;">
          <% if (author.avatar) { %>
            <img src="<%- url_for(author.avatar) %>" alt="<%= author.name || config.author %>"
              style="width:160px;height:160px;object-fit:cover;display:block;"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <div style="display:none;width:160px;height:160px;background:var(--color-tertiary-fixed);align-items:center;justify-content:center;">
              <span class="material-symbols-outlined" style="font-size:48px;color:var(--color-outline);">person</span>
            </div>
          <% } else { %>
            <div style="width:160px;height:160px;background:var(--color-tertiary-fixed);display:flex;align-items:center;justify-content:center;">
              <span class="material-symbols-outlined" style="font-size:48px;color:var(--color-outline);">person</span>
            </div>
          <% } %>
        </div>
        <div style="position:absolute;bottom:-12px;right:-12px;width:40px;height:40px;border-radius:50%;background:var(--color-secondary-container);display:flex;align-items:center;justify-content:center;border:1.5px solid var(--color-primary);box-shadow:2px 2px 0 var(--color-primary);">
          <span class="material-symbols-outlined" style="font-size:18px;color:var(--color-on-secondary-container);font-variation-settings:'FILL' 1;">favorite</span>
        </div>
      </div>

      <div style="text-align:center;max-width:460px;">
        <h1 style="font-family:var(--font-display);font-size:42px;font-weight:600;line-height:1.15;letter-spacing:-0.02em;color:var(--color-primary);margin-bottom:12px;position:relative;display:inline-block;">
          <%= page.title || 'About Me' %>
          <div style="position:absolute;bottom:-2px;left:0;width:100%;height:5px;background:var(--color-secondary-container);opacity:0.7;transform:rotate(-1deg);border-radius:3px;"></div>
        </h1>
        <% if (author.bio) { %>
          <p style="font-family:var(--font-body);font-size:17px;line-height:1.75;color:var(--color-on-surface-variant);margin-top:14px;">
            <%= author.bio %>
          </p>
        <% } %>
      </div>
    </section>

    <!-- ════ Trait Cards ════ -->
    <section style="display:grid;grid-template-columns:1fr;gap:24px;margin-bottom:64px;">
      <!-- Card 1 — Mint (green) -->
      <div class="hand-drawn-border" style="position:relative;padding:28px;background:var(--pastel-mint);box-shadow:3px 3px 0 var(--macaron-green);transition:transform 0.2s;" onmouseenter="this.style.transform='translate(-2px,-2px)'" onmouseleave="this.style.transform=''">
        <div style="position:absolute;top:-8px;right:16px;width:36px;height:10px;background:var(--macaron-green);opacity:0.5;transform:rotate(-12deg);border-radius:2px;"></div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
          <span class="material-symbols-outlined" style="color:var(--color-primary);font-variation-settings:'FILL' 1;font-size:22px;">terminal</span>
          <h3 style="font-family:var(--font-display);font-size:22px;font-weight:500;color:var(--color-primary);" data-i18n="about.digitalCraft">Digital Craft</h3>
        </div>
        <p style="font-family:var(--font-body);font-size:15px;line-height:1.65;color:var(--color-on-surface-variant);" data-i18n="about.digitalCraftDesc">
          I treat code like bookbinding—every line is an intentional stitch. I build minimal, fast, and soulful digital experiences.
        </p>
      </div>

      <!-- Card 2 — Pink -->
      <div class="hand-drawn-border" style="position:relative;padding:28px;background:var(--pastel-pink);box-shadow:3px 3px 0 var(--macaron-pink);transition:transform 0.2s;" onmouseenter="this.style.transform='translate(-2px,-2px)'" onmouseleave="this.style.transform=''">
        <div style="position:absolute;top:-8px;right:16px;width:36px;height:10px;background:var(--macaron-pink);opacity:0.5;transform:rotate(-12deg);border-radius:2px;"></div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
          <span class="material-symbols-outlined" style="color:var(--color-primary);font-variation-settings:'FILL' 1;font-size:22px;">face_6</span>
          <h3 style="font-family:var(--font-display);font-size:22px;font-weight:500;color:var(--color-primary);" data-i18n="about.humanCentric">Human Centric</h3>
        </div>
        <p style="font-family:var(--font-body);font-size:15px;line-height:1.65;color:var(--color-on-surface-variant);" data-i18n="about.humanCentricDesc">
          Technology should serve the human pace of life, not the other way around. My work prioritizes calm and clarity.
        </p>
      </div>
    </section>

    <!-- ════ Quote ════ -->
    <section style="margin-bottom:64px;">
      <div style="padding:32px;background:var(--pastel-blue);border-left:4px solid var(--macaron-blue);position:relative;">
        <div style="position:absolute;top:12px;right:16px;opacity:0.08;">
          <span class="material-symbols-outlined" style="font-size:56px;">format_quote</span>
        </div>
        <p style="font-family:var(--font-label);font-size:16px;font-weight:500;line-height:1.7;color:var(--color-on-surface-variant);font-style:italic;" data-i18n="about.quote">
          "I believe in the beauty of things that take time to grow. In a world of instant feeds, I choose the deliberate scratch of ink on paper."
        </p>
      </div>
    </section>

    <!-- ════ ☕ Buy Me a Coffee ════ -->
    <% if (donate.buymeacoffee || donate.ko_fi || donate.wechat || donate.alipay) { %>
    <section style="margin-bottom:64px;">
      <div style="padding:40px 28px;background:var(--color-surface-container-low);border-radius:8px;border-left:3px solid var(--macaron-orange);">
        <div style="display:flex;align-items:flex-start;gap:16px;margin-bottom:20px;">
          <span class="material-symbols-outlined" style="font-size:24px;color:var(--macaron-orange);flex-shrink:0;margin-top:2px;">coffee</span>
          <div>
            <h2 style="font-family:var(--font-display);font-size:20px;font-weight:500;color:var(--color-primary);margin-bottom:8px;" data-i18n="about.coffeeTitle">Buy Me a Coffee</h2>
            <p style="font-family:var(--font-body);font-size:15px;line-height:1.7;color:var(--color-on-surface-variant);max-width:520px;" data-i18n="about.coffeeDesc">
              If you find this helpful, consider buying me a coffee — all sponsors can leave an email and a wish in the note, and I&rsquo;ll send a random digital resource or a personal reply based on it. Thanks for your support!
            </p>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding-left:40px;">
          <% if (donate.buymeacoffee) { %>
            <a href="<%= donate.buymeacoffee %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;background:var(--macaron-orange);color:#5c4030;padding:8px 20px;border-radius:20px;font-family:var(--font-label);font-size:14px;font-weight:600;text-decoration:none;transition:opacity 0.2s;" onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
              <span class="material-symbols-outlined" style="font-size:18px;">coffee</span>Buy Me a Coffee
            </a>
          <% } %>
          <% if (donate.ko_fi) { %>
            <a href="<%= donate.ko_fi %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;background:var(--macaron-blue);color:#3a4a5a;padding:8px 20px;border-radius:20px;font-family:var(--font-label);font-size:14px;font-weight:600;text-decoration:none;transition:opacity 0.2s;" onmouseenter="this.style.opacity='0.85'" onmouseleave="this.style.opacity='1'">
              <span class="material-symbols-outlined" style="font-size:18px;">loyalty</span>Ko-fi
            </a>
          <% } %>
        </div>

        <% if (donate.wechat || donate.alipay) { %>
          <div style="display:flex;justify-content:flex-start;gap:24px;margin-top:20px;padding-left:40px;">
            <% if (donate.wechat) { %>
              <div style="text-align:center;">
                <div class="hand-drawn-border" style="width:100px;height:100px;padding:5px;background:#fff;display:inline-block;">
                  <img src="<%- url_for(donate.wechat) %>" alt="WeChat" style="width:100%;height:100%;object-fit:contain;" />
                </div>
                <span style="display:block;font-family:var(--font-label);font-size:12px;color:var(--color-on-surface-variant);margin-top:6px;">WeChat</span>
              </div>
            <% } %>
            <% if (donate.alipay) { %>
              <div style="text-align:center;">
                <div class="hand-drawn-border" style="width:100px;height:100px;padding:5px;background:#fff;display:inline-block;">
                  <img src="<%- url_for(donate.alipay) %>" alt="Alipay" style="width:100%;height:100%;object-fit:contain;" />
                </div>
                <span style="display:block;font-family:var(--font-label);font-size:12px;color:var(--color-on-surface-variant);margin-top:6px;">Alipay</span>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <!-- ════ Connect ════ -->
    <section style="margin-bottom:64px;">
      <h2 style="font-family:var(--font-display);font-size:22px;font-weight:500;color:var(--color-primary);margin-bottom:20px;" data-i18n="about.connect">Let's Connect</h2>
      <div style="display:flex;flex-direction:column;gap:12px;">

        <% if (social.rednote) { %>
        <a href="<%= social.rednote %>" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:12px;font-family:var(--font-body);font-size:15px;color:var(--color-on-surface-variant);text-decoration:none;padding:8px 0;transition:color 0.2s;" onmouseenter="this.style.color='var(--color-primary)'" onmouseleave="this.style.color='var(--color-on-surface-variant)'">
          <span style="width:34px;height:34px;border-radius:50%;background:var(--pastel-orange);display:flex;align-items:center;justify-content:center;">
            <span class="material-symbols-outlined" style="font-size:18px;">bookmark</span>
          </span>
          <span data-i18n="about.rednote">RedNote</span>
        </a>
        <% } %>

        <% if (social.github) { %>
        <a href="<%= social.github %>" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:12px;font-family:var(--font-body);font-size:15px;color:var(--color-on-surface-variant);text-decoration:none;padding:8px 0;transition:color 0.2s;" onmouseenter="this.style.color='var(--color-primary)'" onmouseleave="this.style.color='var(--color-on-surface-variant)'">
          <span style="width:34px;height:34px;border-radius:50%;background:var(--pastel-mint);display:flex;align-items:center;justify-content:center;">
            <span class="material-symbols-outlined" style="font-size:18px;">code</span>
          </span>
          <span data-i18n="about.github">GitHub</span>
        </a>
        <% } %>

        <% if (social.email) { %>
        <a href="mailto:<%= social.email %>" style="display:flex;align-items:center;gap:12px;font-family:var(--font-body);font-size:15px;color:var(--color-on-surface-variant);text-decoration:none;padding:8px 0;transition:color 0.2s;" onmouseenter="this.style.color='var(--color-primary)'" onmouseleave="this.style.color='var(--color-on-surface-variant)'">
          <span style="width:34px;height:34px;border-radius:50%;background:var(--pastel-blue);display:flex;align-items:center;justify-content:center;">
            <span class="material-symbols-outlined" style="font-size:18px;">mail</span>
          </span>
          <span data-i18n="about.email">Email</span>
        </a>
        <% } %>

      </div>
    </section>

  </div>
</main>
