<%
  const themeMenu = theme.menu || {};
  const blogName  = theme.blog_name || config.title || 'Ink & Paper';
  const navAccent = {
    '/traces':   'var(--macaron-blue)',
    '/notes':    'var(--macaron-green)',
    '/projects': 'var(--macaron-orange)',
    '/about':    'var(--macaron-pink)',
  };
  const navI18n = {
    'Traces':   'nav.traces',
    'Notes':    'nav.notes',
    'Projects': 'nav.projects',
    'About Me': 'nav.about',
  };
%>

<header class="site-header">
  <div class="container">

    <!-- Logo -->
    <a href="/" class="site-logo">
      <img src="<%- url_for('/images/logo.png') %>" alt="..." class="site-logo-img" />
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav">
      <% Object.keys(themeMenu).forEach(name => {
        const href = url_for(themeMenu[name]);
        const accent = navAccent[themeMenu[name]] || '';
        const i18nKey = navI18n[name] || '';
      %>
        <a href="<%- href %>" data-accent="<%= accent %>" data-i18n="<%= i18nKey %>"><%= name %></a>
      <% }) %>
      <button id="lang-toggle" class="lang-toggle" aria-label="切换语言">
        <span class="lang-toggle-track">
          <span class="lang-toggle-thumb"></span>
          <span class="lang-toggle-option left">中文</span>
          <span class="lang-toggle-option right">EN</span>
        </span>
      </button>
    </nav>

    <!-- Mobile menu button -->
    <button class="nav-menu-btn" aria-label="Toggle menu">
      <span class="material-symbols-outlined">menu</span>
    </button>

  </div>

  <!-- Mobile nav drawer -->
  <nav class="mobile-nav">
    <% Object.keys(themeMenu).forEach(name => {
      const href = url_for(themeMenu[name]);
      const accent = navAccent[themeMenu[name]] || '';
      const i18nKey = navI18n[name] || '';
    %>
      <a href="<%- href %>" data-accent="<%= accent %>" data-i18n="<%= i18nKey %>"><%= name %></a>
    <% }) %>
    <button id="lang-toggle-m" class="lang-toggle" aria-label="切换语言" style="align-self:flex-start;margin-top:8px;">
        <span class="lang-toggle-track">
          <span class="lang-toggle-thumb"></span>
          <span class="lang-toggle-option left">中文</span>
          <span class="lang-toggle-option right">EN</span>
        </span>
      </button>
  </nav>
</header>
