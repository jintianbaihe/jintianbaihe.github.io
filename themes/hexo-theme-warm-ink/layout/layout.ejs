<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% if (page.title) { %>
      <%= page.title %> | <%= config.title %>
    <% } else { %>
      <%= config.title %>
    <% } %>
  </title>
  <meta name="description" content="<%= page.description || config.description || '' %>" />

  <!-- Fonts (preconnect for speed) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700&family=Work+Sans:wght@400;500&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- Theme stylesheet -->
  <%- css('css/style') %>

  <!-- RSS -->
  <% if (config.feed) { %>
    <link rel="alternate" type="application/atom+xml" href="<%= url_for(config.feed.path || 'atom.xml') %>" title="<%= config.title %> RSS" />
  <% } %>
</head>
<body>

  <!-- ── Header / Nav ── -->
  <%- partial('partials/header') %>

  <!-- ── Page Content ── -->
  <%- body %>

  <!-- ── Footer ── -->
  <%- partial('partials/footer') %>

  <!-- Theme JS -->
  <%- js('js/main') %>

</body>
</html>
