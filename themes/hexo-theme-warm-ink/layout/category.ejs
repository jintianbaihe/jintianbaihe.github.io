<%
  const posts = page.posts;
  const catName = page.category || '';
%>

<main class="page-main">
  <div class="container">

    <div class="page-hero">
      <h1><%= catName %></h1>
      <p><%= posts.length %> posts in this category.</p>
    </div>

    <div class="post-list">
      <% posts.each(post => { %>
        <article class="post-item">
          <div class="post-item-left">
            <span class="bullet-macaron" style="margin-top:8px;"></span>
            <div>
              <div class="post-item-meta">
                <span class="post-date"><%= date(post.date, 'MMM D, YYYY') %></span>
              </div>
              <a href="<%- url_for(post.path) %>">
                <h2 class="post-item-title"><%= post.title %></h2>
              </a>
            </div>
          </div>
          <div class="post-item-right">
            <span class="material-symbols-outlined post-arrow">arrow_forward</span>
          </div>
        </article>
      <% }) %>
    </div>

    <% if (page.total > 1) { %>
    <nav class="pagination">
      <%- paginator({ prev_text: '← Prev', next_text: 'Next →' }) %>
    </nav>
    <% } %>

  </div>
</main>
